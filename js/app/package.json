    "expo-updates": "55.0.13",
    "expo-video": "55.0.10",
    "expo-web-browser": "55.0.9",
    "frimousse": "^0.4.0",
    "hls.js": "^1.7.3",
    "i18next": "^26.5.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-fluent": "^3.0.0",
