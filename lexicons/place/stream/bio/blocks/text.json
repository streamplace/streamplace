{
  "lexicon": 1,
  "id": "place.stream.bio.blocks.text",
  "defs": {
    "main": {
      "type": "object",
      "description": "A paragraph of rich text.",
      "required": ["plaintext"],
      "properties": {
        "plaintext": {
          "type": "string"
        },
        "facets": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "place.stream.richtext.facet"
          }
        },
        "textSize": {
          "type": "string",
          "enum": ["default", "small", "large"]
        }
      }
    }
  }
}
