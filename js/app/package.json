    "react-native-web": "^0.21.4",
    "react-native-webrtc": "git+https://github.com/streamplace/react-native-webrtc.git#74fa32266e3a2fee180f5e01bb8753af2a92d9d3",
    "react-native-webview": "13.16.0",
