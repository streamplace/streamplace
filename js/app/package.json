    "reanimated-color-picker": "^5.1.3",
    "rtcaudiodevice": "git+https://github.com/streamplace/RTCAudioDevice.git#38bf55484ca14366e4322c565aa4ed025107734b",
    "sdp-transform": "^3.0.0",
    "stream-http": "^3.2.0",
    "streamplace": "workspace:*",
