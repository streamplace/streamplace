{
  "name": "@streamplace/e2e-web",
  "version": "0.12.14",
  "private": true,
  "description": "Headless-web e2e flows (Playwright) — the web counterpart to the .maestro/ mobile flows",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "install-browser": "playwright install --with-deps chromium firefox"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  }
}
