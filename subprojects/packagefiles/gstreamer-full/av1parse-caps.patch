index f19bf8d..e740d54 100644
--- a/subprojects/gst-plugins-bad/gst/videoparsers/gstav1parse.c
+++ b/subprojects/gst-plugins-bad/gst/videoparsers/gstav1parse.c
@@ -1068,8 +1068,13 @@ gst_av1_parse_set_sink_caps (GstBaseParse * parse, GstCaps * caps)
       && default_stream_format)
     self->detect_annex_b = TRUE;
 
