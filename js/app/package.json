{
  "name": "@streamplace/app",
  "main": "./src/entrypoint.tsx",
  "engines": {
    "node": "22.x"
  },
  "version": "0.12.14",
  "runtimeVersion": "0.12.0",
  "scripts": {
    "start": "pnpm --filter @streamplace/i18n compile && npx expo start -c --port 38081",
    "start:fast": "npx expo start --port 38081",
    "dev:ios": "bash scripts/dev-ios.sh",
    "ui:shoot": "bash scripts/ui-shoot.sh",
    "android": "expo run:android --no-bundler",
    "ios": "expo run:ios --no-bundler",
    "web": "pnpm --filter @streamplace/i18n compile && npx expo start --web --port 38081",
    "test": "jest --watchAll",
    "brand": "pnpm --filter @streamplace/brand generate",
    "build": "pnpm run build:web && pnpm run prebuild",
    "build:web": "pnpm --filter @streamplace/i18n compile && pnpm run brand && node scripts/generate-build-info.js && pnpm run export && node exportClientExpoConfig.js > dist/expoConfig.json",
    "export": "(expo export --dump-sourcemap || expo export --dump-sourcemap) && node scripts/bootstrap-web.mjs",
    "analyze:web": "pnpm run brand && EXPO_ATLAS=true expo export --platform web --output-dir .expo/atlas-web --dump-sourcemap && node scripts/bootstrap-web.mjs .expo/atlas-web && expo-atlas --no-open",
    "check": "pnpm --filter @streamplace/i18n compile && bash -c 'set -euo pipefail;export OUT=$(mktemp -d); npx tsc -p . --outDir $OUT; npx tsc -p tsconfig.wallet.json --noEmit; rm -rf $OUT'",
    "prebuild": "pnpm run brand && EXPO_NO_GIT_STATUS=1 expo prebuild --clean && sed -i.bak 's/org.gradle.jvmargs=-Xmx2048m -XX:MaxMetaspaceSize=512m/org.gradle.jvmargs=-Xmx4096m -XX:MaxMetaspaceSize=1024m/' android/gradle.properties && pnpm run find-node",
    "prepare": "which pod && pnpm run prepare-ios || echo 'not a mac, not installing pods' && mkdir -p ./public && cp -r ../i18n/public/locales ./public/",
    "prepare-ios": "cd ios && pod install && pnpm run find-node",
    "find-node": "node -p '`NODE_BINARY=${process.argv[0]}`' > ios/.xcode.env.local",
    "code-signing-dev": "mkdir -p code-signing-dev/keys code-signing-dev/certs && expo-updates codesigning:generate --key-output-directory code-signing-dev/keys --certificate-output-directory code-signing-dev/certs --certificate-validity-duration-years 10 --certificate-common-name 'Streamplace'",
    "i18n:compile": "node scripts/compile-translations.js",
    "i18n:copy": "mkdir -p public/locales && cp -r src/i18n/locales/data/* public/locales/",
    "i18n:build": "npm run i18n:compile && npm run i18n:copy",
    "i18n:watch": "nodemon --exec \"npm run i18n:build\" --watch src/i18n/locales/data/**/*.ftl",
    "i18n:extract": "node scripts/extract-i18n.js && node scripts/migrate-keys-to-ftl.js",
    "gen:emoji": "node scripts/gen-emoji-data.js"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@atproto-labs/pipe": "^0.2.4",
    "@atproto/api": "^0.29.1",
    "@atproto/crypto": "^0.5.7",
    "@atproto/jwk-jose": "^0.2.4",
    "@atproto/jwk-webcrypto": "^0.3.4",
    "@atproto/oauth-client": "^0.8.10",
    "@atproto/oauth-client-browser": "^0.5.10",
    "@atproto/oauth-client-expo": "0.0.10",
    "@babel/runtime": "^7.29.10",
    "@bacons/text-decoder": "^0.0.0",
    "@fluent/bundle": "^0.19.1",
    "@fluent/langneg": "^0.7.0",
    "@fluent/react": "^0.15.2",
    "@formatjs/intl-displaynames": "^7.3.15",
    "@formatjs/intl-getcanonicallocales": "^3.2.12",
    "@formatjs/intl-locale": "^5.3.12",
    "@react-native-firebase/app": "23.8.8",
    "@react-native-firebase/messaging": "23.8.8",
    "@react-navigation/bottom-tabs": "8.0.0-alpha.16",
    "@react-navigation/drawer": "8.0.0-alpha.16",
    "@react-navigation/native": "8.0.0-alpha.14",
    "@react-navigation/native-stack": "8.0.0-alpha.17",
    "@sentry/cli": "^3.8.1",
    "@sentry/react-native": "7.13.0",
    "@streamplace/components": "workspace:*",
    "@streamplace/core": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "@walletconnect/sign-client": "^2.26.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "abortcontroller-polyfill": "^1.7.6",
    "babel-preset-expo": "55.0.11",
    "buffer": "^6.0.3",
    "burnt": "0.12.2",
