{
  "name": "@streamplace/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Streamplace i18n: locale data, manifest, Fluent sources, compiled translations, and platform-agnostic config.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "bash -c 'set -euo pipefail;export OUT=$(mktemp -d); npx tsc -p . --outDir $OUT; rm -rf $OUT'",
    "compile": "node scripts/compile-translations.js",
    "compile:watch": "nodemon --watch 'locales/**/*.ftl' --exec 'node scripts/compile-translations.js'",
    "extract": "i18next-cli extract && node scripts/migrate-i18n.js",
    "test": "echo \"no tests yet\" && exit 0"
  },
  "dependencies": {
    "i18next": "^25.4.2",
    "i18next-fluent": "^2.0.0",
    "i18next-resources-to-backend": "^1.2.1",
    "intl-pluralrules": "^2.0.1"
  },
  "devDependencies": {
    "@fluent/syntax": "^0.19.0",
    "i18next-cli": "^1.32.0",
    "nodemon": "^3.1.10"
  }
}
