    "sdp-transform": "^3.0.0",
    "stream-http": "^3.2.0",
    "streamplace": "workspace:*",
    "tus-js-client": "^4.3.1",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-proposal-export-default-from": "^7.29.7",
