#!/bin/bash

# This script is used to trick the GitHub action for golangci-lint to run inside a container
# so that we can use the local build of streamplace

set -uo pipefail

# The golangci-lint-action's node-spawned invocations of podman exec hang
# forever on runner images >= 20260823 while bash-spawned ones are fine
# (compare the sanity-check step in golangci-lint.yaml). Point podman's
# stderr at a file instead of the action's pipe, guard with a timeout so a
# hang fails in minutes instead of hours, and dump podman's debug trace on
# failure so we can see where it stuck.
DBG="$(mktemp)"
timeout -k 10 180 podman --log-level=debug exec golangci-lint golangci-lint "$@" </dev/null 2>"$DBG"
code=$?
if [ "$code" -ne 0 ]; then
  echo "wrapper: podman exec exited $code; podman debug log follows" >&2
  cat "$DBG" >&2
else
  # forward golangci-lint's own stderr, minus podman's debug chatter
  grep -v '^time=' "$DBG" >&2 || true
fi
rm -f "$DBG"
exit $code
