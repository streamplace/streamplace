{
  "lexicon": 1,
  "id": "place.stream.vod.getLikes",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get likes for a subject (video or comment).",
      "parameters": {
        "type": "params",
        "required": ["subject"],
        "properties": {
          "subject": {
            "type": "string",
            "format": "at-uri",
            "description": "AT-URI of the subject (video or comment)."
          },
          "cursor": {
            "type": "string",
            "description": "Optional pagination cursor."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "description": "Maximum number of likes to return."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["subject", "count"],
          "properties": {
            "subject": { "type": "string", "format": "at-uri" },
            "count": {
              "type": "integer",
              "minimum": 0,
              "description": "Total number of likes for this subject."
            },
            "cursor": { "type": "string" },
            "likes": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#likeView"
              }
            }
          }
        }
      }
    },
    "likeView": {
      "type": "object",
      "required": ["uri", "cid", "author", "record", "indexedAt"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "author": {
          "type": "ref",
          "ref": "app.bsky.actor.defs#profileViewBasic"
        },
        "record": { "type": "unknown" },
        "indexedAt": { "type": "string", "format": "datetime" }
      }
    }
  }
}
