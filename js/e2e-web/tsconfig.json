{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2024", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "flows/**/*.ts",
    "desktop/**/*.ts",
    "global-setup.ts",
    "storage.ts",
    "playwright.config.ts",
    "playwright.desktop.config.ts"
  ]
}
