{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Streamplace",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/build-${config:streamplace.buildPlatform}/libstreamplace",
      "preLaunchTask": "build-libstreamplace",
      "args": [
        "--broadcaster-host=127.0.0.1:38080",
        "--no-firehose",
        "--wide-open",
        "--livepeer-gateway-url=http://127.0.0.1:8081"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "GOTOOLCHAIN": "auto",
        "LD_LIBRARY_PATH": "${workspaceFolder}/build-${config:streamplace.buildPlatform}/lib",
        "ELECTRON_DISABLE_SANDBOX": "1",
        "SP_DEV_FRONTEND_PROXY_ORIGIN": "http://127.0.0.1:38080",
        "SP_DEV_PUBLIC_OAUTH": "true"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Run Streamplace App Dev Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "pnpm run app start"],
      "cwd": "${workspaceFolder}",
      "env": {
        "ELECTRON_DISABLE_SANDBOX": "1"
      },
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Run Streamplace + App Dev Server",
      "configurations": ["Run Streamplace", "Run Streamplace App Dev Server"]
    }
  ]
}
