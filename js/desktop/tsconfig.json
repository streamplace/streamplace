{
  "compilerOptions": {
    "target": "ES2022",
    "allowJs": true,
    "module": "preserve",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["es2022"]
  },
  "ts-node": {
    "compilerOptions": {
      "module": "Node16",
      "moduleResolution": "Node16"
    }
  },
  "include": ["src/**/*"]
}
