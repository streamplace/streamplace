{
  "name": "@streamplace/e2e-web",
  "version": "0.13.4",
  "private": true,
  "description": "Headless-web e2e flows (Playwright) — the web counterpart to the .maestro/ mobile flows",
  "scripts": {
    "test": "playwright test",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "test:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "install-browser": "playwright install --with-deps chromium firefox"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3"
  }
}
