{
  "compilerOptions": {
    "target": "ES2022",
    "allowJs": true,
    "module": "Node16",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "lib": ["es2021"]
  },
  "include": ["src/**/*"]
}
