    "@zoontek/react-native-navigation-bar": "^2.0.2",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "abortcontroller-polyfill": "^1.7.8",
    "babel-preset-expo": "58.0.24",
