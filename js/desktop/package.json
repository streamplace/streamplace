{
  "name": "streamplace-desktop",
  "productName": "streamplace-desktop",
  "version": "0.12.16",
  "description": "Streamplace Desktop Application",
  "main": ".webpack/main/index.cjs",
  "scripts": {
    "start": "PORT=38082 electron-forge start",
    "start-with-node": "electron-forge start",
    "package": "pnpm --filter @streamplace/brand generate && electron-forge package",
    "make": "pnpm --filter @streamplace/brand generate && electron-forge make",
    "publish": "electron-forge publish",
    "nolint": "eslint --ext .ts,.tsx .",
    "prepare": "CGO_ENABLED=0 go run ../../pkg/config/git/git.go --js > src/version.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-webpack": "^8.0.1",
    "@electron-forge/publisher-s3": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@reforged/maker-appimage": "^6.0.0",
    "@types/source-map-support": "^0.5.10",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vercel/webpack-asset-relocator-loader": "1.11.0",
    "css-loader": "^7.1.5",
    "electron": "45.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "node-loader": "^2.1.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "keywords": [],
  "author": {
    "name": "Streamplace Inc.",
    "email": "support@stream.place"
  },
  "license": "MIT",
  "dependencies": {
    "@atproto/crypto": "^0.5.7",
    "electron-squirrel-startup": "^1.0.1",
    "source-map-support": "^0.5.21",
    "update-electron-app": "^3.3.0",
    "uuid": "^14.0.3",
    "viem": "^2.57.16"
  },
  "private": true
}
