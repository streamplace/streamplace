# URL of the Streamplace Go backend. Used for OAuth client metadata,
# PDS resolution, and as the API base. If unset, the web app uses
# window.location.origin (which works in production when the Go
# binary serves the SPA as static assets).
#
# For local dev against the standard Go port:
#   VITE_STREAMPLACE_URL=http://127.0.0.1:38080

# Optional PLC directory used by DID and OAuth resolution.
# Defaults to https://plc.directory. Expo builds use EXPO_PUBLIC_PLC_URL.
# VITE_PLC_URL=https://plc.example.com
