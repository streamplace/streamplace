#!/bin/bash

# This script is used to trick the GitHub action for golangci-lint to run inside a container
# so that we can use the local build of streamplace

set -euo pipefail

# stdin must not be a live pipe: when golangci-lint-action spawns this wrapper,
# podman exec waits on the inherited stdin and hangs forever (observed on
# runner image 20260823+); bash-spawned invocations were unaffected
exec podman exec golangci-lint golangci-lint "$@" < /dev/null
