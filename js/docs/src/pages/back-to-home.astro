---
import "../styles/custom-font-face.css"
import "@fontsource/atkinson-hyperlegible-next/400.css"
import "@fontsource/atkinson-hyperlegible-next/600.css"
---
<style>
* {
  font-family: "Atkinson Hyperlegible Next";
}
</style>

<script is:inline>
let hostname = window.location.host
const redirectUrl = hostname.endsWith('.stream.place')
  ? 'https://stream.place'
  : '/';
  window.location.href = redirectUrl;
</script>
<body style="display: flex; color: white; justify-content: center; align-items: center; height: 100vh; background-color: #181818; flex: 1; flex-direction: column;">
<h1>Redirecting to Streamplace...&nbsp;</h1>
<a href="https://stream.place" style="color: lightskyblue">Click here if you are not redirected automatically</a>
</body>
