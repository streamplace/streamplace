{
  "name": "@streamplace/web",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "description": "Streamplace web app (Vite + TanStack Router). True-DOM, no React Native.",
  "scripts": {
    "dev": "vite --port 5173",
    "predev": "pnpm --filter @streamplace/i18n compile && pnpm gen:emoji",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173",
    "check": "bash -c 'set -euo pipefail;export OUT=$(mktemp -d); npx tsc -p . --outDir $OUT; rm -rf $OUT'",
    "precheck": "pnpm --filter @streamplace/i18n compile",
    "gen:emoji": "node scripts/gen-emoji-data.mjs",
    "prebuild": "pnpm --filter @streamplace/i18n compile && pnpm gen:emoji",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "pretest": "pnpm --filter @streamplace/i18n compile",
    "test:watch": "vitest",
    "e2e": "npx playwright test",
    "e2e:ui": "npx playwright test --ui"
  },
  "dependencies": {
    "@atproto/api": "^0.30.0",
    "@atproto/crypto": "^0.5.7",
    "@atproto/oauth-client-browser": "^0.5.11",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/helpers": "^0.5.3",
    "@dnd-kit/react": "^0.5.3",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@sentry/react": "^11.10.0",
    "@streamplace/core": "workspace:*",
    "@streamplace/i18n": "workspace:*",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "^1.170.46",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-mention": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/suggestion": "^3.32.2",
    "class-variance-authority": "^0.7.1",
    "color": "^5.0.3",
    "emojibase": "^18.0.0",
    "frimousse": "^0.4.0",
    "hls.js": "~1.7.4",
    "i18next": "^26.7.1",
    "i18next-fluent": "^3.0.0",
    "lucide-react": "^1.68.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.12",
    "recharts": "^3.10.1",
    "sonare": "^0.0.1",
    "sonner": "^2.0.8",
    "streamplace": "workspace:*",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "^11.10.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-mcp": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "emojibase-data": "^18.0.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
