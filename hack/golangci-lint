#!/bin/bash

# This script is used to trick the GitHub action for golangci-lint to run
# inside a container so that we can use the local build of streamplace.
#
# The golangci-lint-action spawns this via node's child_process.exec, whose
# stdio "pipes" are actually libuv socketpairs; podman exec wedges right
# after startup when attached to them on runner images >= 20260823, while
# bash-spawned runs of the identical command are fine. Keep podman's stdio
# pointed at real files and replay them when it finishes. If podman still
# hangs, SIGQUIT it for a Go goroutine dump and fail fast instead of eating
# the job's timeout.

set -uo pipefail

OUT="$(mktemp)"
ERR="$(mktemp)"
trap 'rm -f "$OUT" "$ERR"' EXIT

podman exec golangci-lint golangci-lint "$@" </dev/null >"$OUT" 2>"$ERR" &
pid=$!

seconds=0
while kill -0 "$pid" 2>/dev/null && [ "$seconds" -lt 900 ]; do
  sleep 1
  seconds=$((seconds + 1))
done

if kill -0 "$pid" 2>/dev/null; then
  echo "wrapper: podman exec still running after ${seconds}s; sending SIGQUIT for goroutine dump" >&2
  kill -QUIT "$pid" 2>/dev/null || true
  sleep 5
  kill -KILL "$pid" 2>/dev/null || true
fi

wait "$pid"
code=$?

cat "$OUT"
cat "$ERR" >&2
exit $code
