{
  "name": "streamplace-monorepo",
  "private": true,
  "version": "0.0.0-monorepo",
  "description": "The video layer for everything.",
  "main": "index.js",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "preinstall": "node hack/node-version.js",
    "check": "knip && pnpm run lint && pnpm run test:eslint && pnpm run check:workspaces && git ls-files | xargs prettier --check --ignore-unknown",
    "check:workspaces": "pnpm --filter @streamplace/i18n test && pnpm --filter @streamplace/components test && cd js/app && pnpm run check && pnpm --filter @streamplace/e2e-web run typecheck",
    "lint": "eslint --no-warn-ignored \"js/app/src/**/*.{ts,tsx}\" \"js/app/components/**/*.{ts,tsx}\" \"js/app/hooks/**/*.{ts,tsx}\" \"js/components/src/**/*.{ts,tsx}\"",
    "test:eslint": "node --test \"js/scripts/eslint/*.test.mjs\"",
    "fix": "git ls-files | xargs prettier --write --ignore-unknown",
    "prepare": "husky && pnpm --filter @streamplace/i18n compile && pnpm --filter @streamplace/brand generate",
    "brand": "pnpm --filter @streamplace/brand generate",
    "build": "pnpm --stream -r run build",
    "release": "lerna version --force-publish=@streamplace/app",
    "precommit": "make precommit",
    "app": "cd js/app && pnpm run",
    "web": "cd js/web && pnpm run",
    "components": "cd js/components && pnpm run",
    "desktop": "cd js/desktop && pnpm run",
    "docs": "cd js/docs && pnpm run",
    "start": "pnpm run -r --stream --parallel start",
    "knip": "knip"
  },
  "keywords": [],
  "author": "Streamplace",
  "license": "MIT",
  "devDependencies": {
    "@atproto/lex": "^0.4.4",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "lerna": "~10.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "typescript": "^6.0.3"
  },
  "workspaces": [
    "js/*"
  ],
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "lex-md": "^0.1.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "quicktype": "^26.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
